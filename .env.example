# Copia este archivo como .env.local (local) o configura estas variables en Vercel.
# Todas son opcionales: también pueden editarse directamente en src/config/site.ts.

# URL pública del sitio, sin "/" final. Ej.: https://www.tudominio.com
NEXT_PUBLIC_SITE_URL=

# Número de WhatsApp: solo dígitos, con código de país, sin "+".
NEXT_PUBLIC_WHATSAPP_NUMBER=
